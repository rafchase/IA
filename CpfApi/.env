# Bearer token para autenticação da API
ApiToken=supersecret123

# Token da assinatura ReceitaWS (necessário para consultas reais)
ReceitaWsToken=

# URL base do serviço ReceitaWS (opcional)
ReceitaWsUrl=https://www.receitaws.com.br/v1/cpf

# Token da assinatura ReceitaWS para CNPJ (necessário para consultas reais)
ReceitaWsCnpjToken=

# URL base do serviço ReceitaWS para CNPJ (opcional)
ReceitaWsCnpjUrl=https://www.receitaws.com.br/v1/cnpj
